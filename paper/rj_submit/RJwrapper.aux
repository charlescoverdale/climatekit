\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Three temperature indices for New York Central Park (GHCND station USW00094728), 1950 to 2024. Annual counts from raw daily $T_{\min }$, $T_{\max }$, and $T_{\mathrm  {mean}}$. Blue solid: frost days ($T_{\min } < 0^\circ $C), linear trend $-2.6$ days per decade. Red dashed: summer days ($T_{\max } \geq 25^\circ $C), trend $+0.3$ days per decade. Green dotdash: growing degree days above base $10^\circ $C, divided by 20 for visual scale, trend $+28$ GDD per decade. Dotted lines are OLS trend fits.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:central-park}{{4}{5}{Three temperature indices for New York Central Park (GHCND station USW00094728), 1950 to 2024. Annual counts from raw daily $T_{\min }$, $T_{\max }$, and $T_{\mathrm {mean}}$. Blue solid: frost days ($T_{\min } < 0^\circ $C), linear trend $-2.6$ days per decade. Red dashed: summer days ($T_{\max } \geq 25^\circ $C), trend $+0.3$ days per decade. Green dotdash: growing degree days above base $10^\circ $C, divided by 20 for visual scale, trend $+28$ GDD per decade. Dotted lines are OLS trend fits}{figure.caption.5}{}}
